# Endpoint da API Serverless de Contato (API Gateway HTTP API v2)
VITE_CONTACT_API_URL=https://example.execute-api.us-east-1.amazonaws.com/contact

# Site Key pública do Cloudflare Turnstile (Anti-Bot)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Feature Flag: Habilita o acesso e carregamento do módulo Cloudwardens ("true" em Staging/Dev, "false" em Produção)
VITE_ENABLE_CLOUDWARDENS=false

